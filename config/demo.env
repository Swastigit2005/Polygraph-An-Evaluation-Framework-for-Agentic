# Non-secret demo settings (committed). Secrets such as GROQ_API_KEY go in the host's secret store or .env.
GEN_MODEL=openai/gpt-oss-120b
FAST_MODEL=openai/gpt-oss-20b
JUDGE_MODEL=qwen/qwen3.8-27b
GROQ_RPM_LIMIT=28
GROQ_TPM_LIMIT=7500
MODEL_PRICES=openai/gpt-oss-120b=0.15/0.60,openai/gpt-oss-20b=0.075/0.30,qwen/qwen3.8-27b=0.80/4.00
RETRIEVAL_MODE=hybrid
USE_RERANKER=true
USE_REFLECTION=true
MAX_REWRITES=2
TOP_K=4
CANDIDATE_K=20
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LANGFUSE_HOST=https://cloud.langfuse.com
JSON_MODE_MODELS=qwen/qwen3.8-27b
MODEL_MAX_OUTPUT=qwen/qwen3.8-27b=900
