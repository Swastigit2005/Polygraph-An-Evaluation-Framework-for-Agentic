# Copy to .env and fill in. Never commit .env.

# --- Groq (free tier): https://console.groq.com/keys ---
GROQ_API_KEY=
# Model ids: pick from `python scripts/list_groq_models.py`; never hard-coded in code.
GEN_MODEL=
FAST_MODEL=
JUDGE_MODEL=
# Client-side limits; set at or slightly under your Groq console limits for the models above.
GROQ_RPM_LIMIT=30
GROQ_TPM_LIMIT=6000
# Optional list prices (USD per 1M tokens) for cost accounting: "model=in/out,model=in/out".
# The free tier is not billed; this reports what the same usage would cost on a paid plan.
MODEL_PRICES=

# --- Agent behaviour (every ablation is expressed through these) ---
RETRIEVAL_MODE=hybrid   # dense | bm25 | hybrid
USE_RERANKER=true
USE_REFLECTION=true
MAX_REWRITES=2
TOP_K=4
CANDIDATE_K=20

# --- Local models (sentence-transformers, CPU) ---
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Optional Langfuse tracing (no-op when unset) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
